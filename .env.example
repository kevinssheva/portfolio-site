# Development only. Production always excludes drafts, even if this is true.
CONTENT_PREVIEW_DRAFTS=false

# Optional canonical HTTPS origin. Leave empty until the real production URL is known.
# Set this in Vercel's Production environment; VERCEL_ENV is supplied by Vercel.
# Indexing is enabled only when this is set and VERCEL_ENV=production.
SITE_URL=
